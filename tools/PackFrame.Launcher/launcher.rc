        BEGIN
            VALUE "FileDescription", "Rimworld PackFrame Launcher"
            VALUE "ProductName", "Rimworld PackFrame"
            VALUE "OriginalFilename", "Rimworld PackFrame.exe"
        END
    END
    BLOCK "VarFileInfo"
