<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PackFrame.ColorPaletteWindow"
        Title="Rimworld PackFrame"
        Width="840"
        Height="560"
        MinWidth="620"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        RequestedThemeVariant="Dark">
    <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock x:Name="TitleText"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryTextBrush}" />
        <TextBlock x:Name="HintText"
                   Grid.Row="1"
                   Margin="0,8,0,0"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   TextWrapping="Wrap" />
        <ScrollViewer Grid.Row="2"
                      Margin="0,14,0,0"
                      HorizontalScrollBarVisibility="Disabled">
            <WrapPanel x:Name="PalettePanel"
                       ItemWidth="142"
                       ItemHeight="72" />
        </ScrollViewer>
        <Grid Grid.Row="3"
              ColumnDefinitions="*,Auto"
              Margin="0,12,0,0">
            <TextBlock x:Name="ShortcutHint"
                       FontSize="12"
                       Foreground="{DynamicResource MutedTextBrush}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="8">
                <Button x:Name="ClearButton"
                        Theme="{StaticResource FlatButton}"
                        MinHeight="32"
                        Click="OnClearClick" />
                <Button x:Name="CancelButton"
                        Theme="{StaticResource FlatButton}"
                        MinHeight="32"
                        Click="OnCancelClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
