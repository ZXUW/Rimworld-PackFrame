<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:PackFrame"
        x:Class="PackFrame.MainWindow"
        Title="Rimworld PackFrame"
        Width="1500"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        RequestedThemeVariant="Dark">
    <Window.Resources>
        <DataTemplate x:Key="ModTemplate" x:DataType="local:ModInfo">
            <Border Background="{Binding RowBrush}">
                <Grid ColumnDefinitions="Auto,*,Auto" Opacity="{Binding SearchOpacity}">
                    <TextBlock Text="{Binding LoadOrderText}"
                               IsVisible="{Binding HasLoadOrder}"
                               Width="{Binding LoadOrderGutterWidth}"
                               Margin="0,0,8,0"
                               TextAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <Border Grid.Column="2"
                            Width="22"
                            Height="22"
                            VerticalAlignment="Center"
                            Margin="8,0,0,0"
                            Background="Transparent"
                            ToolTip.ShowDelay="200"
                            PointerEntered="OnModBadgePointerEntered"
                            PointerExited="OnModBadgePointerExited">
                        <local:ModBadge Badges="{Binding ActiveBadges}"
                                        Width="22"
                                        Height="22" />
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Name}"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               Effect="{Binding NameEffect}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               ToolTip.ShowDelay="200"
                               ToolTip.Tip="{Binding ColorLabel}" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Window.Styles>
        <Style Selector="Border.pane-header Border.header-tint">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Border.pane-header.enable-target Border.header-tint">
            <Setter Property="Opacity" Value="0.08" />
        </Style>
        <Style Selector="ListBox.modpane:not(.pane-active) ListBoxItem:selected /template/ Border#PART_Border">
            <Setter Property="Background" Value="{DynamicResource SecondaryBrush}" />
        </Style>
        <Style Selector="ListBox.modpane:not(.pane-active) ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SecondaryBrush}" />
        </Style>
    </Window.Styles>
    <Grid Margin="12" RowDefinitions="Auto,Auto,*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto,Auto" VerticalAlignment="Top">
            <Button x:Name="LanguageButton"
                    Grid.Column="0"
                    Theme="{StaticResource FlatButton}"
                    Content="文/A"
                    Padding="10,8"
                    MinWidth="50"
                    MinHeight="36"
                    Margin="0,0,10,0" />
            <TextBlock x:Name="GamePathLabel"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"
                       Foreground="{DynamicResource PrimaryTextBrush}" />
            <Border x:Name="PathField"
                    Grid.Column="2"
                    Classes="field"
                    CornerRadius="0"
                    MinHeight="36">
                <TextBox x:Name="PathBox"
                         Background="Transparent"
                         BorderThickness="0"
                         CornerRadius="0"
                         VerticalContentAlignment="Center"
                         VerticalAlignment="Stretch" />
            </Border>
            <Button x:Name="AutoDetectGameButton"
                    Grid.Column="3"
                    Theme="{StaticResource FlatButton}"
                    Margin="12,0,0,0"
                    MinHeight="36"
                    Click="OnAutoDetectGameClick" />
            <Button x:Name="BrowseButton"
                    Grid.Column="4"
                    Theme="{StaticResource FlatButton}"
                    Margin="8,0,0,0"
                    MinHeight="36" />
        </Grid>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,8,0,0">
            <Button x:Name="PaintModeButton"
                    Theme="{StaticResource FlatButton}"
                    MinHeight="32"
                    Padding="18,6"
                    Click="OnPaintModeClick" />
            <Button x:Name="UndoButton"
                    Theme="{StaticResource FlatButton}"
                    MinHeight="32"
                    Padding="18,6"
                    Click="OnUndoClick" />
            <Button x:Name="RedoButton"
                    Theme="{StaticResource FlatButton}"
                    MinHeight="32"
                    Padding="18,6"
                    Click="OnRedoClick" />
            <Button x:Name="SyncConfigButton"
                    Theme="{StaticResource FlatButton}"
                    MinHeight="32"
                    Padding="18,6"
                    IsVisible="False"
                    Click="OnSyncConfigClick" />
            <Button x:Name="RefreshButton"
                    Theme="{StaticResource FlatButton}"
                    MinHeight="32"
                    Padding="18,6"
                    Click="OnRefreshClick" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,8,0,0" ColumnDefinitions="420,12,*">
            <Border Grid.Column="0"
                    Background="Transparent"
                    BorderBrush="{StaticResource SecondaryBrush}"
                    BorderThickness="1"
                    Padding="12">
                <Grid RowDefinitions="240,Auto,Auto,Auto,Auto,Auto,*">
                    <Image x:Name="PreviewImage"
                           Grid.Row="0"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />

                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,8,0,0">
                        <SelectableTextBlock x:Name="NameLabel"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Top"
                                   Margin="0,0,10,0" />
                        <SelectableTextBlock x:Name="NameValue"
                                   Grid.Column="1"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*" Margin="0,6,0,0">
                        <SelectableTextBlock x:Name="AuthorLabel"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Top"
                                   Margin="0,0,10,0" />
                        <SelectableTextBlock x:Name="AuthorValue"
                                             Grid.Column="1"
                                             Foreground="{DynamicResource PrimaryTextBrush}"
                                             TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <Grid Grid.Row="3" ColumnDefinitions="Auto,*" Margin="0,6,0,0">
                        <SelectableTextBlock x:Name="PathLabel"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Top"
                                   Margin="0,0,10,0" />
                        <SelectableTextBlock x:Name="PathValue"
                                             Grid.Column="1"
                                             Foreground="{DynamicResource PrimaryTextBrush}"
                                             TextWrapping="Wrap" />
                    </Grid>

                    <Grid Grid.Row="4" ColumnDefinitions="Auto,*" Margin="0,6,0,0">
                        <SelectableTextBlock x:Name="PackageLabel"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   VerticalAlignment="Top"
                                   Margin="0,0,10,0" />
                        <SelectableTextBlock x:Name="PackageValue"
                                             Grid.Column="1"
                                             Foreground="{DynamicResource PrimaryTextBrush}"
                                             TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <SelectableTextBlock x:Name="DescriptionLabel"
                               Grid.Row="5"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,10,0,2" />

                    <ScrollViewer Grid.Row="6" VerticalScrollBarVisibility="Auto">
                        <SelectableTextBlock x:Name="DescriptionValue"
                                             Foreground="{DynamicResource PrimaryTextBrush}"
                                             TextWrapping="Wrap" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid x:Name="ManagerColumns" Grid.Column="2" ColumnDefinitions="*,8,*,8,*">
                <Border Grid.Column="0"
                        Background="Transparent"
                        BorderBrush="{StaticResource SecondaryBrush}"
                        BorderThickness="1"
                        Padding="8">
                    <Grid RowDefinitions="Auto,30,*,Auto">
                        <Grid RowDefinitions="30" Margin="2,0,2,4">
                            <Grid>
                            <Button x:Name="InactiveSortButton"
                                Grid.Row="0"
                                Theme="{StaticResource FlatButton}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                MinHeight="26"
                                Height="26"
                                Padding="6,2"
                                Margin="2,0,0,0"
                                Click="OnInactiveSortClick" />
                        <TextBlock x:Name="InactiveHeader"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Margin="2,0,2,0" />
                            </Grid>
                        </Grid>
                        <Grid Grid.Row="1"
                              ColumnDefinitions="*,Auto,Auto,Auto"
                              Margin="0,2,0,2">
                            <Border Classes="field"
                                    Height="26"
                                    CornerRadius="0">
                                <TextBox x:Name="InactiveSearchBox"
                                         Background="#01000000"
                                         BorderThickness="0"
                                         CornerRadius="0"
                                         Padding="8,3"
                                         VerticalContentAlignment="Center" />
                            </Border>
                            <ComboBox x:Name="InactiveSearchField"
                                      Grid.Column="1"
                                      MinWidth="64"
                                      MinHeight="26"
                                      Height="26"
                                      Padding="6,3"
                                      Margin="4,0,0,0" />
                            <Button x:Name="InactiveSourceButton"
                                    Grid.Column="2"
                                    Theme="{StaticResource FlatButton}"
                                    MinWidth="48"
                                    MinHeight="26"
                                    Height="26"
                                    Padding="4,2"
                                    Margin="4,0,0,0"
                                    Click="OnInactiveSourceClick" />                            <Button x:Name="InactiveViewModeButton"
                                    Grid.Column="3"
                                    Theme="{StaticResource FlatButton}"
                                    Width="26"
                                    MinWidth="26"
                                    MinHeight="26"
                                    Height="26"
                                    Padding="0"
                                    Margin="4,0,0,0"
                                    Click="OnInactiveViewModeClick" />
                        </Grid>
                        <ListBox x:Name="InactiveList"
                                 Classes="modpane"
                                 ItemTemplate="{StaticResource ModTemplate}"
                                 Grid.Row="2"
                                 ItemContainerTheme="{StaticResource ModListItem}"
                                 SelectionChanged="OnListSelectionChanged">
                        </ListBox>                        <Border Grid.Row="3"
                                BorderBrush="{StaticResource SecondaryBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="4,4,4,2">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock x:Name="InactiveProblemV"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           TextWrapping="NoWrap"
                                           Cursor="Hand"
                                           PointerPressed="OnInactiveProblemVClick" />
                                <TextBlock x:Name="InactiveProblemR"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           TextWrapping="NoWrap"
                                           Cursor="Hand"
                                           PointerPressed="OnInactiveProblemRClick" />
                                <TextBlock x:Name="InactiveLocalCount"
                                           Text="L: 0"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           TextWrapping="NoWrap"
                                           Cursor="Hand"
                                           PointerPressed="OnInactiveLocalCountClick" />
                            </StackPanel>
                        </Border>                    </Grid>
                </Border>

                <Border x:Name="ActiveColumn1"
                        Grid.Column="2"
                        Background="Transparent"
                        BorderBrush="{StaticResource SecondaryBrush}"
                        BorderThickness="1"
                        Padding="8">
                    <Grid RowDefinitions="Auto,30,*,Auto">
                        <Border x:Name="ActivePaneHeader1" Classes="pane-header"
                                Grid.Row="0" Margin="0,0,0,4">
                          <Grid>
                            <Border Classes="header-tint"
                                    Background="{DynamicResource PrimaryTextBrush}"
                                    IsHitTestVisible="False" />
                            <Grid RowDefinitions="34,30" Margin="2,0,2,0">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <ComboBox x:Name="InstanceCombo1"
                                          MinWidth="0"
                                          FontWeight="SemiBold"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center"
                                          SelectionChanged="OnInstanceSelectionChanged" />
                                <Border x:Name="SameListBadge1"
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        IsVisible="False">
                                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="12" />
                                </Border>
                                <Button x:Name="SplitViewButton"
                                        Grid.Column="2"
                                        Theme="{StaticResource FlatButton}"
                                        MinHeight="28"
                                        Padding="6,4"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Click="OnSplitViewClick">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Width="14" Height="14" Stretch="Uniform"
                                              VerticalAlignment="Center"
                                              Stroke="{DynamicResource PrimaryTextBrush}"
                                              StrokeThickness="1.25"
                                              Data="M 1,1 L 13,1 L 13,13 L 1,13 Z M 7,1 L 7,13" />
                                        <TextBlock x:Name="SplitViewLabel"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*">
                                <Button x:Name="InstanceActionButton1"
                                        Theme="{StaticResource FlatButton}"
                                        Content="…"
                                        Padding="8,4"
                                        MinWidth="30"
                                        MinHeight="28"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Click="OnInstanceActionsClick" />
                                <Button x:Name="ModpackButton1"
                                        Grid.Column="1"
                                        Theme="{StaticResource FlatButton}"
                                        Padding="10,4"
                                        MinHeight="28"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Click="OnModpack1Click" />
                                <TextBlock x:Name="ActiveHeader1"
                                           Grid.Column="2"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                            </Grid>
                          </Grid>
                        </Border>
                        <Grid Grid.Row="1"
                              ColumnDefinitions="*,Auto,Auto,Auto"
                              Margin="0,2,0,2">
                            <Border Classes="field"
                                    Height="26"
                                    CornerRadius="0">
                                <TextBox x:Name="ActiveSearchBox1"
                                         Background="#01000000"
                                         BorderThickness="0"
                                         CornerRadius="0"
                                         Padding="8,3"
                                         VerticalContentAlignment="Center" />
                            </Border>
                            <ComboBox x:Name="ActiveSearchField1"
                                      Grid.Column="1"
                                      MinWidth="64"
                                      MinHeight="26"
                                      Height="26"
                                      Padding="6,3"
                                      Margin="4,0,0,0" />
                            <Button x:Name="ActiveSourceButton1"
                                    Grid.Column="2"
                                    Theme="{StaticResource FlatButton}"
                                    MinWidth="48"
                                    MinHeight="26"
                                    Height="26"
                                    Padding="4,2"
                                    Margin="4,0,0,0"
                                    Click="OnActiveSource1Click" />                            <Button x:Name="ActiveViewModeButton1"
                                    Grid.Column="3"
                                    Theme="{StaticResource FlatButton}"
                                    Width="26"
                                    MinWidth="26"
                                    MinHeight="26"
                                    Height="26"
                                    Padding="0"
                                    Margin="4,0,0,0"
                                    Click="OnActiveViewMode1Click" />
                        </Grid>
                        <ListBox x:Name="ActiveList1"
                                 Classes="modpane"
                                 ItemTemplate="{StaticResource ModTemplate}"
                                 Grid.Row="2"
                                 ItemContainerTheme="{StaticResource ModListItem}"
                                 SelectionChanged="OnListSelectionChanged">
                        </ListBox>                        <Border Grid.Row="3"
                                BorderBrush="{StaticResource SecondaryBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="4,4,4,2">
                            <Grid ColumnDefinitions="Auto,Auto,Auto,*">
                                <TextBlock x:Name="ActiveProblemS1"
                                           Margin="0,0,12,0"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           TextWrapping="NoWrap"
                                           Cursor="Hand"
                                           PointerPressed="OnActiveProblemS1Click" />
                                <TextBlock x:Name="ActiveProblemV1"
                                           Grid.Column="1" Margin="0,0,12,0"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           TextWrapping="NoWrap"
                                           Cursor="Hand"
                                           PointerPressed="OnActiveProblemV1Click" />
                                <TextBlock x:Name="ActiveProblemR1"
                                           Grid.Column="2" Margin="0,0,12,0"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           TextWrapping="NoWrap"
                                           Cursor="Hand"
                                           PointerPressed="OnActiveProblemR1Click" />
                                <TextBlock x:Name="ActiveLocalCount1"
                                           Text="L: 0"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           TextWrapping="NoWrap"
                                           Cursor="Hand"
                                           PointerPressed="OnActiveLocalCount1Click" />
                                <Button x:Name="ActiveMissing1"
                                        Grid.Column="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Classes="footerlink"
                                        IsVisible="False"
                                        Click="OnMissing1Click" />
                            </Grid>
                        </Border>                    </Grid>
                </Border>

                <Border x:Name="ActiveColumn2"
                        Grid.Column="4"
                        Background="Transparent"
                        BorderBrush="{StaticResource SecondaryBrush}"
                        BorderThickness="1"
                        Padding="8">
                    <Grid RowDefinitions="Auto,30,*,Auto">
                        <Border x:Name="ActivePaneHeader2" Classes="pane-header"
                                Grid.Row="0" Margin="0,0,0,4">
                          <Grid>
                            <Border Classes="header-tint"
                                    Background="{DynamicResource PrimaryTextBrush}"
                                    IsHitTestVisible="False" />
                            <Grid RowDefinitions="34,30" Margin="2,0,2,0">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <ComboBox x:Name="InstanceCombo2"
                                          MinWidth="0"
                                          FontWeight="SemiBold"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center"
                                          SelectionChanged="OnInstanceSelectionChanged" />
                                <Border x:Name="SameListBadge2"
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        IsVisible="False">
                                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                                               FontSize="12" />
                                </Border>
                                <Button x:Name="CloseSecondaryPaneButton"
                                        Grid.Column="2"
                                        Theme="{StaticResource FlatButton}"
                                        Width="28" Height="28"
                                        Padding="7"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Click="OnCloseSecondaryPaneClick">
                                    <Path Width="12" Height="12" Stretch="Uniform"
                                          Stroke="{DynamicResource PrimaryTextBrush}"
                                          StrokeThickness="1.5"
                                          Data="M 1,1 L 11,11 M 11,1 L 1,11" />
                                </Button>
                            </Grid>
                            <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*">
                                <Button x:Name="InstanceActionButton2"
                                        Theme="{StaticResource FlatButton}"
                                        Content="…"
                                        Padding="8,4"
                                        MinWidth="30"
                                        MinHeight="28"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Click="OnInstanceActionsClick" />
                                <Button x:Name="ModpackButton2"
                                        Grid.Column="1"
                                        Theme="{StaticResource FlatButton}"
                                        Padding="10,4"
                                        MinHeight="28"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Click="OnModpack2Click" />
                                <TextBlock x:Name="ActiveHeader2"
                                           Grid.Column="2"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                            </Grid>
                          </Grid>
                        </Border>
                        <Grid Grid.Row="1"
                              ColumnDefinitions="*,Auto,Auto,Auto"
                              Margin="0,2,0,2">
                            <Border Classes="field"
                                    Height="26"
                                    CornerRadius="0">
                                <TextBox x:Name="ActiveSearchBox2"
                                         Background="#01000000"
                                         BorderThickness="0"
                                         CornerRadius="0"
                                         Padding="8,3"
                                         VerticalContentAlignment="Center" />
                            </Border>
                            <ComboBox x:Name="ActiveSearchField2"
                                      Grid.Column="1"
                                      MinWidth="64"
                                      MinHeight="26"
                                      Height="26"
                                      Padding="6,3"
                                      Margin="4,0,0,0" />
                            <Button x:Name="ActiveSourceButton2"
                                    Grid.Column="2"
                                    Theme="{StaticResource FlatButton}"
                                    MinWidth="48"
                                    MinHeight="26"
                                    Height="26"
                                    Padding="4,2"
                                    Margin="4,0,0,0"
                                    Click="OnActiveSource2Click" />                            <Button x:Name="ActiveViewModeButton2"
                                    Grid.Column="3"
                                    Theme="{StaticResource FlatButton}"
                                    Width="26"
                                    MinWidth="26"
                                    MinHeight="26"
                                    Height="26"
                                    Padding="0"
                                    Margin="4,0,0,0"
                                    Click="OnActiveViewMode2Click" />
                        </Grid>
                        <ListBox x:Name="ActiveList2"
                                 Classes="modpane"
                                 ItemTemplate="{StaticResource ModTemplate}"
                                 Grid.Row="2"
                                 ItemContainerTheme="{StaticResource ModListItem}"
                                 SelectionChanged="OnListSelectionChanged">
                        </ListBox>                        <Border Grid.Row="3"
                                BorderBrush="{StaticResource SecondaryBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="4,4,4,2">
                            <Grid ColumnDefinitions="Auto,Auto,Auto,*">
                                <TextBlock x:Name="ActiveProblemS2"
                                           Margin="0,0,12,0"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           TextWrapping="NoWrap"
                                           Cursor="Hand"
                                           PointerPressed="OnActiveProblemS2Click" />
                                <TextBlock x:Name="ActiveProblemV2"
                                           Grid.Column="1" Margin="0,0,12,0"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           TextWrapping="NoWrap"
                                           Cursor="Hand"
                                           PointerPressed="OnActiveProblemV2Click" />
                                <TextBlock x:Name="ActiveProblemR2"
                                           Grid.Column="2" Margin="0,0,12,0"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           TextWrapping="NoWrap"
                                           Cursor="Hand"
                                           PointerPressed="OnActiveProblemR2Click" />
                                <TextBlock x:Name="ActiveLocalCount2"
                                           Text="L: 0"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           TextWrapping="NoWrap"
                                           Cursor="Hand"
                                           PointerPressed="OnActiveLocalCount2Click" />
                                <Button x:Name="ActiveMissing2"
                                        Grid.Column="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Classes="footerlink"
                                        IsVisible="False"
                                        Click="OnMissing2Click" />
                            </Grid>
                        </Border>                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="3"
              ColumnDefinitions="*,Auto"
              Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="14">
                <Button x:Name="GithubLinkButton"
                        Classes="footerlink"
                        Click="OnGithubLinkClick" />
                <Button x:Name="DiscordLinkButton"
                        Classes="footerlink"
                        Click="OnDiscordLinkClick" />
                <SelectableTextBlock x:Name="QqGroupText"
                                     Foreground="{DynamicResource SecondaryTextBrush}"
                                     VerticalAlignment="Center" />
                <Button x:Name="BackgroundButton"
                        Classes="footerlink"
                        Click="OnBackgroundClick" />
                <Button x:Name="CheckUpdateButton"
                        Classes="footerlink"
                        Click="OnCheckUpdateClick" />
                <Button x:Name="LogButton"
                        Classes="footerlink"
                        Click="OnLogClick" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Spacing="8">
                <Button x:Name="SaveButton"
                        Theme="{StaticResource FlatButton}"
                        MinHeight="36"
                        Padding="24,8"
                        Click="OnSaveClick" />
                <Button x:Name="LaunchButton"
                        Theme="{StaticResource FlatButton}"
                        MinHeight="36"
                        MaxWidth="300"
                        Padding="24,8"
                        IsEnabled="False"
                        Click="OnLaunchClick">
                    <TextBlock x:Name="LaunchTargetText"
                               TextTrimming="CharacterEllipsis" />
                </Button>
            </StackPanel>
        </Grid>

        <Canvas x:Name="DragOverlay"
                Grid.RowSpan="3"
                IsHitTestVisible="False"
                Background="Transparent">
            <Border x:Name="DropTargetOutline"
                    BorderBrush="{DynamicResource PrimaryTextBrush}"
                    BorderThickness="2"
                    IsVisible="False" />
            <Border x:Name="InsertionLine"
                    Height="2"
                    Background="{DynamicResource PrimaryTextBrush}"
                    IsVisible="False" />
            <Border x:Name="DragGhost"
                    Background="{DynamicResource AppBackgroundBrush}"
                    BorderBrush="{DynamicResource SecondaryTextBrush}"
                    BorderThickness="1"
                    Padding="10,6"
                    Width="240"
                    IsVisible="False">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="DragGhostAction"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               TextTrimming="CharacterEllipsis"
                               IsVisible="False" />
                    <TextBlock x:Name="DragGhostText"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           MaxHeight="100"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </Canvas>

        <Border x:Name="UndoToast"
                Grid.RowSpan="3"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="16"
                Background="#CC20354A"
                BorderBrush="{StaticResource SecondaryBrush}"
                BorderThickness="1"
                Padding="12,8"
                IsVisible="False">
            <TextBlock x:Name="UndoToastText"
                       Foreground="{DynamicResource PrimaryTextBrush}" />
        </Border>
    </Grid>
</Window>


