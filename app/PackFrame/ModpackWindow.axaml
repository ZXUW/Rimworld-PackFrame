<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:PackFrame"
        x:Class="PackFrame.ModpackWindow"
        Title="Rimworld PackFrame"
        Width="1280"
        Height="820"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterOwner"
        Background="#20354A"
        RequestedThemeVariant="Dark">
    <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Name="TitleText"
                       FontSize="21"
                       FontWeight="SemiBold"
                       Foreground="#EAF1F8"
                       VerticalAlignment="Center" />
            <Button x:Name="RefreshButton"
                    Grid.Column="1"
                    Theme="{StaticResource FlatButton}"
                    MinHeight="32"
                    Padding="18,6"
                    Click="OnRefreshClick" />
        </Grid>

        <Grid Grid.Row="1"
              ColumnDefinitions="Auto,*,Auto"
              Margin="0,10,0,0">
            <TextBlock x:Name="RepoLabel"
                       Foreground="#C3D4E4"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
            <Border Grid.Column="1"
                    Classes="field"
                    MinHeight="32"
                    CornerRadius="0">
                <TextBox x:Name="RepoBox"
                         Background="Transparent"
                         BorderThickness="0"
                         CornerRadius="0"
                         VerticalContentAlignment="Center"
                         KeyDown="OnRepoKeyDown" />
            </Border>
            <Button x:Name="RepoMenuButton"
                    Grid.Column="2"
                    Theme="{StaticResource FlatButton}"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Margin="4,0,0,0"
                    Content="▾"
                    Click="OnRepoMenuClick" />
        </Grid>

        <Grid Grid.Row="2"
              ColumnDefinitions="420,12,*"
              Margin="0,12,0,0">
            <Border Grid.Column="0"
                    BorderBrush="{StaticResource SecondaryBrush}"
                    BorderThickness="1">
                <Grid RowDefinitions="Auto,*">
                    <Border Background="#455364" Padding="10,8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="ListHeader"
                                       Foreground="#EAF1F8"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="ListCount"
                                       Grid.Column="1"
                                       Foreground="#C3D4E4" />
                        </Grid>
                    </Border>
                    <ListBox x:Name="PackList"
                             Grid.Row="1"
                             ItemContainerTheme="{StaticResource ModListItem}"
                             SelectionChanged="OnPackSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="local:ModpackListItem">
                                <StackPanel Margin="4,3">
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="#EAF1F8"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Summary}"
                                               Foreground="#C3D4E4"
                                               TextWrapping="Wrap"
                                               MaxLines="2"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding CountText}"
                                               Foreground="#9AA7B8"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    BorderBrush="{StaticResource SecondaryBrush}"
                    BorderThickness="1"
                    Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="10">
                        <Border Height="240"
                                Background="#182938"
                                HorizontalAlignment="Stretch">
                            <Image x:Name="CoverImage"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        </Border>
                        <SelectableTextBlock x:Name="PackTitle"
                                             FontSize="21"
                                             FontWeight="SemiBold"
                                             Foreground="#EAF1F8"
                                             TextWrapping="Wrap" />
                        <SelectableTextBlock x:Name="PackMeta"
                                             Foreground="#C3D4E4"
                                             TextWrapping="Wrap" />

                        <SelectableTextBlock x:Name="PackDescription"
                                             Foreground="#EAF1F8"
                                             TextWrapping="Wrap" />
                        <Border BorderBrush="{StaticResource SecondaryBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="0,10,0,0">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="ModsHeader"
                                           Foreground="#C3D4E4"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="EmptyModsText"
                                           Foreground="#C3D4E4"
                                           TextWrapping="Wrap"
                                           IsVisible="False" />
                                <ItemsControl x:Name="ModList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:ModpackModRow">
                                            <Border BorderBrush="#455364"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="0,6">
                                                <Grid ColumnDefinitions="120,*,Auto">
                                                    <TextBlock Text="{Binding Source}"
                                                               Foreground="#C3D4E4"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Name}"
                                                               Foreground="#EAF1F8"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="8,0" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Detail}"
                                                               Foreground="#9AA7B8"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="280" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="{StaticResource SecondaryBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="0,10,0,0">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="LinkLabel"
                                           Foreground="#C3D4E4"
                                           FontWeight="SemiBold" />
                                <Border Classes="field"
                                        MinHeight="32"
                                        CornerRadius="0">
                                    <TextBox x:Name="LinkBox"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             CornerRadius="0"
                                             VerticalContentAlignment="Center" />
                                </Border>

                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    Margin="0,2,0,0">
                            <Button x:Name="InstallButton"
                                    Theme="{StaticResource FlatButton}"
                                    MinHeight="36"
                                    Padding="24,8"
                                    Click="OnInstallClick" />
                            <Button x:Name="SteamCmdButton"
                                    Theme="{StaticResource FlatButton}"
                                    MinHeight="36"
                                    Padding="24,8"
                                    Click="OnSteamCmdInstallClick" />
                            <Button x:Name="WorkshopOnlyButton"
                                    Theme="{StaticResource FlatButton}"
                                    MinHeight="54"
                                    Padding="10,4"
                                    Click="OnWorkshopOnlyInstallClick" />
                            <Button x:Name="ApplyConfigButton"
                                    Theme="{StaticResource FlatButton}"
                                    MinHeight="36"
                                    Padding="24,8"
                                    Click="OnApplyConfigClick" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="3"
              ColumnDefinitions="*,Auto,Auto"
              Margin="0,10,0,0">
            <StackPanel Spacing="4" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText"
                           Foreground="#C3D4E4"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
            </StackPanel>
            <Button x:Name="CancelOperationButton"
                    Grid.Column="1"
                    Classes="footerlink"
                    Content="Cancel"
                    IsVisible="False"
                    Margin="8,0,0,0"
                    Click="OnCancelOperationClick" />
            <Button x:Name="CloseButton"
                    Grid.Column="2"
                    Theme="{StaticResource FlatButton}"
                    MinHeight="32"
                    Padding="24,6"
                    Click="OnCloseClick" />
        </Grid>
    </Grid>
</Window>








