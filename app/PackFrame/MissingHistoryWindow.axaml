<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:PackFrame"
        x:Class="PackFrame.MissingHistoryWindow"
        Title="Rimworld PackFrame"
        Width="1040"
        Height="640"
        MinWidth="820"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        RequestedThemeVariant="Dark">
    <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Name="TitleText"
                       FontSize="21"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       VerticalAlignment="Center" />
            <Button x:Name="ClearButton"
                    Grid.Column="1"
                    Theme="{StaticResource FlatButton}"
                    MinHeight="32"
                    Click="OnClearClick" />
        </Grid>

        <TextBlock x:Name="SummaryText"
                   Grid.Row="1"
                   Margin="0,10,0,0"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   TextWrapping="Wrap" />

        <Border Grid.Row="2"
                Margin="0,12,0,0"
                BorderBrush="{StaticResource SecondaryBrush}"
                BorderThickness="1">
            <Grid RowDefinitions="Auto,*">
                <Border Background="{DynamicResource SecondaryBrush}" Padding="12,9">
                    <Grid ColumnDefinitions="2*,1.1*,1.5*,2*,1.2*">
                        <TextBlock x:Name="LabelHeader"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,12,0" />
                        <TextBlock x:Name="AuthorHeader"
                                   Grid.Column="1"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,12,0" />
                        <TextBlock x:Name="PackageHeader"
                                   Grid.Column="2"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,12,0" />
                        <TextBlock x:Name="LinkHeader"
                                   Grid.Column="3"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,12,0" />
                        <TextBlock x:Name="LastMissingHeader"
                                   Grid.Column="4"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontWeight="SemiBold" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="Rows">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:MissingHistoryEntry">
                                    <Border BorderBrush="{DynamicResource SecondaryBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="12,9">
                                        <Grid ColumnDefinitions="2*,1.1*,1.5*,2*,1.2*">
                                            <SelectableTextBlock Text="{Binding Label}"
                                                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                                                 TextWrapping="Wrap"
                                                                 Margin="0,0,12,0" />
                                            <SelectableTextBlock Grid.Column="1"
                                                                 Text="{Binding Author}"
                                                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                                                 TextWrapping="Wrap"
                                                                 Margin="0,0,12,0" />
                                            <SelectableTextBlock Grid.Column="2"
                                                                 Text="{Binding PackageId}"
                                                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                                                 TextWrapping="Wrap"
                                                                 Margin="0,0,12,0" />
                                            <SelectableTextBlock Grid.Column="3"
                                                                 Text="{Binding Link}"
                                                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                                                 TextWrapping="Wrap"
                                                                 Margin="0,0,12,0" />
                                            <SelectableTextBlock Grid.Column="4"
                                                                 Text="{Binding LastMissingAt}"
                                                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                                                 TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="EmptyText"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsVisible="False" />
                </Grid>
            </Grid>
        </Border>

        <Button x:Name="FooterCloseButton"
                Grid.Row="3"
                Theme="{StaticResource FlatButton}"
                MinHeight="32"
                Padding="24,6"
                HorizontalAlignment="Right"
                Margin="0,12,0,0"
                Click="OnCloseClick" />
    </Grid>
</Window>
