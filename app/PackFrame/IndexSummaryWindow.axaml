<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PackFrame.IndexSummaryWindow"
        Title="Rimworld PackFrame"
        Width="560"
        Height="320"
        MinWidth="420"
        MinHeight="240"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        RequestedThemeVariant="Dark">
    <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock x:Name="HeadingText"
                   Foreground="{DynamicResource PrimaryTextBrush}"
                   FontSize="18"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap" />
        <TextBlock x:Name="HintText"
                   Grid.Row="1"
                   Foreground="{DynamicResource MutedTextBrush}"
                   TextWrapping="Wrap"
                   Margin="0,6,0,8" />
        <Border Grid.Row="2" Classes="field" CornerRadius="0">
            <TextBox x:Name="SummaryBox"
                     Background="Transparent"
                     BorderThickness="0"
                     CornerRadius="0"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </Border>
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,10,0,0">
            <Button x:Name="CancelButton"
                    Theme="{StaticResource FlatButton}"
                    MinHeight="32"
                    Click="OnCancelClick" />
            <Button x:Name="ConfirmButton"
                    Theme="{StaticResource FlatButton}"
                    MinHeight="32"
                    Click="OnConfirmClick" />
        </StackPanel>
    </Grid>
</Window>
